# Firebase Admin SDK service account, base64-encoded
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Firestore collection holding scholarship applications
SCHOLARSHIPS_COLLECTION=scholarships

# Public base URL of this app (used to build consent links in emails)
APP_BASE_URL=https://consent.tanwir.institute

# Shared secret gating /admin and the admin trigger API
ADMIN_TOKEN=

# Emailer service (see emailer/README.md) — must match its MAIL_API_TOKEN
ZAKAT_MAIL_API_URL=https://email.tanwir.institute
ZAKAT_MAIL_API_TOKEN=
