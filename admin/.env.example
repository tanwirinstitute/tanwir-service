# Firebase Admin SDK service account, base64-encoded (same project as consent/)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Firestore collection students + their synced courses are written to
STUDENTS_COLLECTION=students

# Squarespace API (Settings > Advanced > API Keys, needs Orders read scope)
SQUARESPACE_API_KEY=
SQUARESPACE_API_URL=https://api.squarespace.com/1.0

# Shared secret required on POST /api/sync-courses (e.g. by an external cron trigger)
SYNC_API_TOKEN=

# Shared secret required on /dashboard?token=... (matches consent/.env's ADMIN_TOKEN pattern)
ADMIN_TOKEN=

# Firebase Web app config for tanwir-students (public, not secret — see
# `firebase apps:sdkconfig WEB <appId> --project tanwir-students`).
# Used by the dashboard's client-side Firestore listeners; access is gated by
# firestore.rules + the admin custom claim, not by keeping these secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
