# Firebase Admin SDK service account, base64-encoded (tanwir-students project)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Firestore collection students + their synced courses are written to
STUDENTS_COLLECTION=students

# Squarespace API (Settings > Advanced > API Keys, needs Orders read scope)
SQUARESPACE_API_KEY=
SQUARESPACE_API_URL=https://api.squarespace.com/1.0

# Shared secret required on POST /api/sync-courses (e.g. by an external cron trigger)
SYNC_API_TOKEN=

# Emailer service (see ../emailer), used by the Email Console (/email) to send
# test/blast emails. MAIL_API_TOKEN must match MAIL_API_TOKEN in emailer/.env.
EMAIL_ORIGIN=http://localhost:3002
MAIL_API_TOKEN=

# Firebase Web app config for tanwir-students (public, not secret — see
# `firebase apps:sdkconfig WEB <appId> --project tanwir-students`).
# AUTH_DOMAIN is required for Google sign-in (signInWithPopup). Dashboard
# access is gated by Google login + authorizedUsers/{uid} membership
# (firestore.rules) plus an httpOnly Firebase session cookie, not by keeping
# these values secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- Telemetry (see README "Telemetry") ---

# Grafana Cloud OTLP gateway for backend traces + metrics. From Grafana Cloud
# → Connections → "OpenTelemetry (OTLP)": the endpoint, the numeric instance
# ID, and an access-policy token with metrics:write + traces:write. Leave any
# blank to disable backend telemetry.
GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_OTLP_INSTANCE_ID=
GRAFANA_OTLP_TOKEN=
OTEL_DEPLOYMENT_ENVIRONMENT=production

# Grafana Faro frontend RUM. From Grafana Cloud → Frontend Observability →
# your app → "Web SDK" — the collector URL (public; the app key is in the
# URL). Blank = Faro disabled.
NEXT_PUBLIC_FARO_COLLECTOR_URL=
NEXT_PUBLIC_FARO_APP_NAME=tanwir-admin
NEXT_PUBLIC_FARO_ENVIRONMENT=production
