# Squarespace API (Settings > Advanced > API Keys, needs the Discounts
# read/write scope). Base URL has no version suffix for the Discounts API
# (unlike admin's SQUARESPACE_API_URL, which points at /1.0 for the older
# Orders/Profiles APIs) — this app calls POST {url}/v1/commerce/discounts.
SQUARESPACE_API_KEY=
SQUARESPACE_API_URL=https://api.squarespace.com

# Sent as the required User-Agent header on Squarespace API calls.
SQUARESPACE_USER_AGENT=tanwir-api (programs@tanwirinstitute.org)

# Shared secret required in the `Authorization: Bearer <token>` header on
# every endpoint. Must match SYNC_API_TOKEN in admin/.env — this is an
# internal ops action, gated the same way as admin's sync-courses endpoint.
SYNC_API_TOKEN=
